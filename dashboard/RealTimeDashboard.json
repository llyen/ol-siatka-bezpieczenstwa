  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "let akt = TaskActivation | where timestamp between (_startTime .. _endTime)\n    | summarize arg_max(timestamp, activation_status) by task_module_id;\nlet dekl = ReadinessDeclaration | where timestamp between (_startTime .. _endTime)\n    | summarize arg_max(timestamp, status) by admin_division, task_module_id;\nlet plan = SafetyGrid | where hazard_code == 'Z02' and phase == 'R'\n    | where role != 'wspierający' and isnotempty(task_modules)\n    | mv-expand modul = split(task_modules, ';') to typeof(string)\n    | where isnotempty(modul)\n    | extend task_module_id = toint(modul);\nunion\n  (akt  | summarize Wskaznik = 'Moduly uruchomione', Wartosc = countif(activation_status in ('aktywny', 'wygaszanie'))),\n  (akt  | summarize Wskaznik = 'W tym w wygaszaniu', Wartosc = countif(activation_status == 'wygaszanie')),\n  (dekl | summarize Wskaznik = 'Deklaracje gotowosci', Wartosc = count()),\n  (dekl | summarize Wskaznik = 'W tym domkniete', Wartosc = countif(status == 'gotowe')),\n  (dekl | summarize Wskaznik = 'W tym zablokowane', Wartosc = countif(status == 'zablokowane')),\n  (dekl | summarize Wskaznik = 'Dzialy, ktore odpowiedzialy', Wartosc = dcount(admin_division)),\n  (plan | summarize Wskaznik = 'Zadania w planie Z02/R', Wartosc = count()),\n  (plan | summarize Wskaznik = 'Dzialy objete planem', Wartosc = dcount(admin_division))",
      "id": "302e2845-808a-5d40-538e-e38bcd54d11a",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "ReadinessDeclaration\n| where timestamp between (_startTime .. _endTime)\n| summarize Deklaracje = count() by bin(timestamp, 2h), status\n| order by timestamp asc",
      "id": "eed60eb8-2954-3c1d-d93b-45861a09aeb1",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "ReadinessDeclaration\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, status) by admin_division, task_module_id\n| summarize Deklaracje = count() by status\n| order by Deklaracje desc",
      "id": "f36ed26a-6a56-65e6-c502-2d69d2492643",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "TaskActivation\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, day_offset, activation_status, leading_admin_division, trigger_reason) by task_module_id\n| lookup kind=leftouter (dim_task_module | project task_module_id, task_module_name) on task_module_id\n| lookup kind=leftouter (dim_admin_division | project leading_admin_division = admin_division, Lider = admin_name) on leading_admin_division\n| project Modul = task_module_name, Dzien = strcat('D+', day_offset), Status = activation_status,\n          Lider, Przyczyna = trigger_reason, Aktywowano = timestamp\n| order by Aktywowano asc",
      "id": "8e5b85d8-a386-90b9-1674-dd62a8958b70",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "TaskActivation\n| where timestamp between (_startTime .. _endTime)\n| lookup kind=leftouter (dim_task_module | project task_module_id, task_module_name) on task_module_id\n| summarize Zdarzenia = count() by bin(timestamp, 4h), task_module_name\n| order by timestamp asc",
      "id": "887f556b-e5c2-40e1-613c-13303e780708",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "let dekl = ReadinessDeclaration | where timestamp between (_startTime .. _endTime)\n    | summarize arg_max(timestamp, status) by admin_division, task_module_id;\nSafetyGrid\n| where hazard_code == 'Z02' and phase == 'R'\n| where role != 'wspierający' and isnotempty(task_modules)\n| mv-expand modul = split(task_modules, ';') to typeof(string)\n| where isnotempty(modul)\n| extend task_module_id = toint(modul)\n| join kind=leftouter dekl on admin_division, task_module_id\n| extend status = coalesce(status, 'brak deklaracji')\n| summarize Zadania = count() by status\n| order by Zadania desc",
      "id": "9a401752-cfed-591a-7338-5552da962760",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "let dekl = ReadinessDeclaration | where timestamp between (_startTime .. _endTime)\n    | summarize arg_max(timestamp, status) by admin_division, task_module_id;\nSafetyGrid\n| where hazard_code == 'Z02' and phase == 'R'\n| where role != 'wspierający' and isnotempty(task_modules)\n| mv-expand modul = split(task_modules, ';') to typeof(string)\n| where isnotempty(modul)\n| extend task_module_id = toint(modul)\n| join kind=leftouter dekl on admin_division, task_module_id\n| where isempty(status)\n| lookup kind=leftouter (dim_admin_division | project admin_division, admin_name, ministry) on admin_division\n| summarize Brakujace = count(), Wiodace = countif(role == 'wiodący' or role == 'wiodacy') by Dzial = admin_name, Resort = ministry\n| order by Wiodace desc, Brakujace desc\n| take 25",
      "id": "8beb7b2b-84b2-c32f-c307-174c55aab185",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "ReadinessDeclaration\n| where timestamp between (_startTime .. _endTime)\n| summarize arg_max(timestamp, status, comment, forces_and_assets) by admin_division, task_module_id\n| where status == 'zablokowane'\n| lookup kind=leftouter (dim_admin_division | project admin_division, admin_name) on admin_division\n| lookup kind=leftouter (dim_task_module | project task_module_id, task_module_name) on task_module_id\n| project Dzial = admin_name, Modul = task_module_name, Powod = comment, Sily = forces_and_assets, Zgloszono = timestamp\n| order by Zgloszono desc",
      "id": "033b3bdd-f1d4-ae0c-8e10-3aa09cb25223",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "ActivationPlanZ02R()\n| summarize Zadania = count(), Wiodace = countif(role == 'wiodący' or role == 'wiodacy') by Dzial = admin_name\n| where Zadania > 0\n| order by Wiodace desc, Zadania desc\n| take 20",
      "id": "e8935c7a-619a-0608-0d03-85cf9c8c0081",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "CurrentReadiness()\n| project Dzial = admin_name, Modul = task_module_name, Status = status, Zgloszono = timestamp, Uwagi = comment\n| order by Dzial asc, Modul asc",
      "id": "b4adad82-ad07-8abc-5388-2cab15a4797b",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "ReadinessGap()\n| lookup kind=leftouter (dim_admin_division | project admin_division, ministry_x = ministry) on admin_division\n| summarize Zadania = count() by Resort = coalesce(ministry, ministry_x), status\n| order by Zadania desc",
      "id": "279af0d8-0a57-8acc-21f8-44547d26f78d",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "CriticalPathBlockers()\n| project Dzial = admin_name, Resort = ministry, Modul = task_module_name,\n          Powod = comment, Sily = forces_and_assets, Zgloszono = timestamp\n| order by Zgloszono desc",
      "id": "bac36a63-32a1-6216-75a3-da010430f256",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "CurrentReadiness()\n| where status in ('gotowe', 'w toku')\n| project Dzial = admin_name, Modul = task_module_name, Status = status, Sily = forces_and_assets\n| order by Dzial asc",
      "id": "bdbfc450-7fa4-babf-d056-a589abdf2e23",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "ActivationPlanZ02R()\n| project Dzial = admin_name, Resort = ministry, Modul = task_module_name, Rola = role, Krytycznosc = criticality\n| order by Rola asc, Dzial asc",
      "id": "955d885e-27f0-1092-283e-5b78081521a8",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "SafetyGrid\n| where hazard_code == 'Z02'\n| summarize Wpisy = count() by Rola = role, Krytycznosc = criticality\n| order by Wpisy desc",
      "id": "adb2dadf-ad45-0d15-b566-3496584ab6b7",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "ActivationPlanZ02R()\n| summarize Dzialy = dcount(admin_division), Wiodace = countif(role == 'wiodący' or role == 'wiodacy') by Modul = task_module_name\n| order by Dzialy desc",
      "id": "abde8c5f-0c33-404f-4214-da2db13200fe",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "Interdependency\n| lookup kind=leftouter (dim_task_module | project task_module_id, Modul = task_module_name) on task_module_id\n| lookup kind=leftouter (dim_task_module | project depends_on_task_module_id = task_module_id, Zalezy_od = task_module_name) on depends_on_task_module_id\n| project Modul, Zalezy_od, Uzasadnienie = dependency_reason",
      "id": "25e11a92-b499-9a52-c08c-5f5812e451d2",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "SafetyGrid\n| summarize Wpisy = count(), Dzialy = dcount(admin_division) by Zagrozenie = hazard_code, Faza = phase\n| order by Zagrozenie asc, Faza asc",
      "id": "10505c49-39bc-5e7d-d3b1-60d2981a9939",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "SpoStepsForFlood()\n| project Procedura = spo_name, Krok = step_number, Opis = step_description,\n          Dzial = admin_name, SLA_h = sla_hours, Dokument = required_document",
      "id": "10240ecf-511e-2863-d2f1-fb857513c2ad",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "SpoStepsForFlood()\n| summarize Krokow = count(), Min_SLA_h = min(sla_hours), Sredni_SLA_h = round(avg(sla_hours), 1) by Dzial = admin_name\n| order by Min_SLA_h asc\n| take 20",
      "id": "97ff455d-11ae-0e94-cb23-a62a8e3a43e5",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "dim_contact_point\n| lookup kind=leftouter (dim_admin_division | project admin_division, admin_name, ministry) on admin_division\n| project Dzial = admin_name, Resort = ministry, Rola = role, Komorka = unit,\n          Telefon = duty_phone, Email = email, Zastepca = deputy\n| order by Dzial asc",
      "id": "47b55550-509f-7c80-2262-9bbd655c3295",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "dim_hazard\n| project Zagrozenie = hazard_name, Kod = hazard_code, Kategoria = category,\n          Prawdopodobienstwo = probability, Skutki = impact, Ryzyko = risk_score, Poziom = risk_level\n| order by Ryzyko desc",
      "id": "dfca233e-cb6a-f5c0-520d-8ba2386e31ec",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "dim_hazard\n| summarize Zagrozenia = count(), Max_ryzyko = max(risk_score) by Kategoria = category\n| order by Max_ryzyko desc",
      "id": "625ee750-54ba-577e-2999-35762194fe6b",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "5532c541-9928-14a9-994c-01625ee03d53"
      },
      "text": "dim_hazard\n| project Zagrozenie = hazard_name, Ryzyko = risk_score, Poziom = risk_level\n| order by Ryzyko desc\n| take 10",
      "id": "616a5fd2-c42f-5a1f-bf42-dcd0943d7734",
      "usedVariables": []
    }
  ]
